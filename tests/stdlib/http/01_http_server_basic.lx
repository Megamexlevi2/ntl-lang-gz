val io   = @import("std.io")
val http = @import("std.http")
val os   = @import("std.os")

fn main() {
  val server = http.createServer(fn(req, res) {
    if req.path == "/ping" {
      http.json(res, { status: "ok" }, 200)
    } else {
      http.text(res, "not found", 404)
    }
  })

  val handle = http.listen(server, 39217, "127.0.0.1")
  os.sleep(150)

  val resp = http.get("http://127.0.0.1:39217/ping")
  io.log("ok:", resp.ok)
  io.log("status:", resp.status)
  io.log("body_status:", resp.body.status)

  handle.close()
  io.log("PASS http_server_basic")
}
