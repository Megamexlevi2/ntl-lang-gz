val io = @import("std.io"); val buffer = @import("std.buffer")
fn main() {
  val text = buffer.from("Lunex")
  io.log("from string toHex:", text.toHex())
  io.log("from string toString:", text.toString())

  val hexBuf = buffer.from("48656c6c6f", "hex")
  io.log("from hex toString:", hexBuf.toString())

  val b64 = buffer.from("TGlnaHR3b3Jr", "base64")
  io.log("from base64 toString:", b64.toString())

  val arrBuf = buffer.from([1, 2, 3, 4])
  io.log("from array toArray:", arrBuf.toArray())

  val joined = buffer.concat(buffer.from([1, 2]), buffer.from([3, 4]))
  io.log("concat toArray:", joined.toArray())

  val sliced = joined.slice(1, 3)
  io.log("slice toArray:", sliced.toArray())

  io.log("PASS buffer_construct")
}
